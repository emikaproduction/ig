---
import { site } from '../data/site';
const links = [
  { href: '#o-nas', label: 'O nas' },
  { href: '#grafik', label: 'Grafik' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#suple', label: 'Suplementy' },
  { href: '#kontakt', label: 'Kontakt' },
];
---
<!-- Na samej górze przezroczysty; po zjechaniu w dół płynnie dostaje tło, ramkę i rozmycie -->
<header
  data-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-transparent backdrop-blur-[0px] transition-[background-color,border-color,backdrop-filter] duration-500 ease-out data-[scrolled]:border-brand-zinc data-[scrolled]:bg-brand-black/70 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-18 max-w-[1360px] items-center justify-between gap-6 px-6">
    <a href="#top" class="shrink-0">
      <img src="/logo.jpg" srcset="/logo.jpg 1x, /logo-400.jpg 2x" alt="Iron Gym Pisz" width="56" height="56" class="size-14 rounded-full" />
    </a>
    <nav aria-label="Główna" class="hidden gap-9 text-[13px] font-semibold tracking-[0.14em] uppercase md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-zinc-400 transition-colors hover:text-white">{l.label}</a>
      ))}
    </nav>
    <a href={site.phoneHref} class="btn-primary px-5 py-3 text-xs">Zadzwoń</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', scrollY > 16);
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
